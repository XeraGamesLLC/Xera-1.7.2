# Copy this to .env before running `docker compose up`.
# Generate secrets with: openssl rand -hex 64

POSTGRES_PASSWORD=change_me_to_something_random
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret

# Domain Caddy will fetch a real Let's Encrypt certificate for — must be a
# real, publicly-resolvable hostname (an IP literal won't work). If you
# don't have a domain yet, a free sslip.io hostname for your server's IP
# works: e.g. 185-182-9-183.sslip.io for the IP 185.182.9.183.
XRA_DOMAIN=chat.yourdomain.com

# The public origin(s) your frontend is served from, comma-separated.
# Must match XRA_DOMAIN above (with https://) once TLS is on.
CORS_ORIGINS=https://chat.yourdomain.com

# Anti-VPN signup gate — off until a provider is wired up (see backend/src/middleware/antiVpn.ts)
ANTI_VPN_ENABLED=false
ANTI_VPN_API_KEY=
