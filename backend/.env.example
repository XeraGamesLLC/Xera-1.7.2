# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=postgresql://xra:xra_dev_password@localhost:5432/xra?schema=public

# --- Redis (rate limiting, presence cache, socket.io adapter) ---
REDIS_URL=redis://localhost:6379

# --- Auth token signing key (generate with: openssl rand -hex 64) ---
# Tokens are Discord-shaped: base64(userId).base64(tokenVersion).base64(HMAC).
# No expiry — a token is valid until User.tokenVersion changes (logout or
# password reset), not on a timer. See src/utils/token.ts.
JWT_ACCESS_SECRET=changeme_generate_a_long_random_secret

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_AVATAR_SIZE_MB=8
MAX_ATTACHMENT_SIZE_MB=25

# --- Anti-VPN (stubbed, see src/middleware/antiVpn.ts) ---
# Set to "true" to actually block signups flagged as VPN/proxy once a provider is wired up.
ANTI_VPN_ENABLED=false
# Example future provider key, unused while ANTI_VPN_ENABLED=false
ANTI_VPN_API_KEY=

# --- Rate limiting ---
# Requests per window, per IP, for the general API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
